# Phase 1 runs without database credentials.
# Optional HTTPS tile URL. Keep visible OpenStreetMap attribution if using OSM data.
# Standard OSM tiles are for interactive viewing; do not prefetch or bulk download.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Reserved for Phase 2; the Phase 1 demo does not read these values.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Never add a service-role or secret key to a NEXT_PUBLIC_ variable.
