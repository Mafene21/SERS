# Required for the staff dashboard. Use the project's publishable key only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional local-only demo. Vercel ignores this flag and requires real sign-in.
SERS_DEMO_MODE=false
# Optional HTTPS tile URL. Keep visible OpenStreetMap attribution if using OSM data.
# Standard OSM tiles are for interactive viewing; do not prefetch or bulk download.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Never add a service-role or secret key to a NEXT_PUBLIC_ variable.
